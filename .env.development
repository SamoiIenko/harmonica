# Development server configuration — read automatically by CRA on `npm start`.
# Requires the one-time machine setup described in README.md ("Local setup").
# Committed on purpose: every developer should get the same local origin.

#
# --- Origin -------------------------------------------------------------------
#

# Bind to the harmonica.local hostname (mapped to 127.0.0.1 in the OS hosts
# file) instead of the default 0.0.0.0, so the app is never served on localhost.
HOST=harmonica.local

# Port 443 keeps the URL clean: https://harmonica.local, no port suffix.
PORT=443

#
# --- TLS ----------------------------------------------------------------------
#

# getDisplayMedia() / getUserMedia(), used by @features/audio/soundRecorder, are
# only exposed in a secure context. localhost is implicitly trusted by the
# browser but harmonica.local is not, so the dev server has to serve real TLS.
HTTPS=true

# Paths are resolved relative to the project root by CRA's getHttpsConfig.
# Generated by mkcert into the gitignored certs/ folder — see README.md.
SSL_CRT_FILE=certs/harmonica.local.pem
SSL_KEY_FILE=certs/harmonica.local-key.pem
